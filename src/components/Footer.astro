---
import { SITE } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/">{SITE.name}</a>
      <p>{SITE.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <p class="footer-heading">Explore</p>
      <ul>
        <li><a href="/#work">Work</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href={`mailto:${SITE.email}`}>Contact</a></li>
      </ul>
    </nav>

    <div>
      <p class="footer-heading">Elsewhere</p>
      <ul>
        <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub</a></li>
        <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      </ul>
    </div>
  </div>

   <div class="wrap footer-bottom">
    <span>&copy; {year} {SITE.name}</span>
    <a href="/privacy">Privacy Policy</a>
  </div>
</footer>